# Kopieer dit bestand naar .env.local en vul in wat je nodig hebt.

# ── Profielen en voortgang ──────────────────────────────────
# De database waar de profielen en de voortgang in staan. Zonder deze
# variabele kun je je niet aanmelden en werkt de app dus niet.
# Maak er een aan via Vercel → Storage → Neon, of op neon.tech.
DATABASE_URL=

# Ondertekent de sessiekoekjes. Maak er zelf een met:
#   openssl rand -base64 32
# Lokaal mag hij leeg blijven — dan gebruikt de app een vast ontwikkelgeheim.
# In productie weigert de app te werken zonder.
SESSION_SECRET=

# Nodig om een nieuw profiel aan te maken — één keer, daarna meld je je aan
# met je naam en pincode. Laat je hem leeg, dan kan iedereen die het adres
# kent een profiel openen en op jouw API-tegoed praten. Lokaal is leeg prima.
UITNODIGINGSCODE=

# ── AI-functies ─────────────────────────────────────────────
# Alleen nodig voor Charla (gesprekken), nieuwe woordenlijsten en het
# aanvullen van grammaticahoofdstukken.
#
# Zonder sleutel werkt de rest gewoon: 419 woorden per taal (A1 t/m C1),
# twintig uitgeschreven grammaticahoofdstukken, de niveautest, de
# oefensessies, de toetsen, de eindexamens en Relámpago draaien lokaal.
ANTHROPIC_API_KEY=
